# Copy to .env and fill in. NEVER commit real secrets.
# All values have safe defaults so the app runs with the deterministic stub LLM
# and an in-memory checkpointer (no Docker, no API keys required).

# --- LLM provider -----------------------------------------------------------
# stub   = deterministic, offline, no key (default; used by tests/eval/CI)
# openai = real GPT via the official openai SDK (requires OPENAI_API_KEY)
LLM_PROVIDER=stub

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_JUDGE_MODEL=gpt-4.1-mini

# --- Checkpointer (durable execution / HITL pause-resume) -------------------
# memory   = InMemorySaver (default; resume only within a single process)
# postgres = PostgresSaver (durable; survives restarts — use `make up` first)
CHECKPOINTER=memory
# Used when CHECKPOINTER=postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://reconciler:reconciler@localhost:5432/reconciler
# Connection-pool bounds (postgres only). Keep DB_POOL_MAX under the server's
# connection limit — managed Postgres tiers cap this aggressively.
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- API input sandbox --------------------------------------------------------
# Documents posted to /runs must resolve under this directory. The API reads
# files off the server's filesystem, so leaving this unbounded would let any
# caller read arbitrary files. Relative paths resolve against the process CWD
# (`/app` in the Docker image); a missing directory fails closed.
DOCUMENTS_ROOT=./data

# --- Document size guards (tools/convert.py, nodes/ingest.py) ----------------
# Per-document character cap at ingest. The OpenAI provider sends the whole
# document as one prompt (no chunking), so this is both the context-length
# guard and the real spend bound for a run — COST_CAP_USD is never consulted
# before extraction. Oversized documents are truncated with a visible warning
# (surfaced in RunStatus.errors), not rejected.
MAX_DOCUMENT_CHARS=400000

# --- Uploads (POST /documents) ------------------------------------------------
# Uploaded files land under <DOCUMENTS_ROOT>/<UPLOAD_SUBDIR>/<batch-id>/, so
# they automatically satisfy the DOCUMENTS_ROOT sandbox above.
MAX_UPLOAD_FILES=8
MAX_UPLOAD_BYTES=26214400
UPLOAD_SUBDIR=uploads

# --- Production guards -------------------------------------------------------
MAX_REFLECTIONS=2
COST_CAP_USD=2.50
# Contradictions at/above this severity OR below this confidence go to a human.
HITL_SEVERITY_THRESHOLD=high
HITL_CONFIDENCE_THRESHOLD=0.75
NUMERIC_TOLERANCE_PCT=0.5

# --- LangSmith tracing / eval (optional) ------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=filing-reconciler

# --- API / CORS ---------------------------------------------------------------
# Origins allowed to call this API (comma-separated). Defaults cover the
# Next.js frontend in `web/` running via `npm run dev` (port 3000).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
